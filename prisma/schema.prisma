// ═══════════════════════════════════════════════════════════════════════════
//  Vyora Marketplace — MySQL + Prisma schema
//
//  Conventions
//  • Primary keys are CUIDs (non-sequential, safe to expose). Customer-facing
//    references use human-friendly numbers (orderNumber, subOrderNumber …).
//  • Money is DECIMAL(12,2) in INR. Calculations run in integer paise in code.
//  • All timestamps are stored in UTC (DATETIME(3)).
//  • `deletedAt` marks soft deletion where history must survive.
//  • Order items snapshot everything needed to render historical orders.
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETION_REQUESTED
  DELETED
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  SELLER_INVITE
  PHONE_OTP
}

enum SellerStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
  INACTIVE
}

enum BusinessType {
  INDIVIDUAL
  PROPRIETORSHIP
  PARTNERSHIP
  LLP
  PRIVATE_LIMITED
  PUBLIC_LIMITED
  OTHER
}

enum FulfillmentMode {
  SELLER
  PLATFORM
}

enum SellerDocumentType {
  GST_CERTIFICATE
  PAN_CARD
  ADDRESS_PROOF
  CANCELLED_CHEQUE
  OTHER
}

enum DocumentStatus {
  UPLOADED
  VERIFIED
  REJECTED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum AttributeType {
  TEXT
  NUMBER
  SELECT
  BOOLEAN
}

enum InventoryMovementType {
  INITIAL
  ADJUSTMENT
  RESERVE
  RELEASE
  SHIP
  RETURN_RESTOCK
  IMPORT
}

enum AddressType {
  HOME
  WORK
  OTHER
}

enum OrderStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURN_APPROVED
  RETURN_REJECTED
  RETURNED
  REFUND_PENDING
  REFUNDED
}

enum PaymentStatus {
  PENDING
  COD_PENDING
  PAID
  FAILED
  REFUND_PENDING
  REFUNDED
}

enum PaymentMethod {
  COD
}

enum ShippingMethod {
  STANDARD
  EXPRESS
}

enum ShipmentStatus {
  PENDING
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKED_UP
  RECEIVED
  REFUNDED
  CANCELLED
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum CommissionScope {
  GLOBAL
  CATEGORY
  SELLER
  SELLER_CATEGORY
  PRODUCT
}

enum CommissionStatus {
  ACCRUED
  EARNED
  REVERSED
}

enum LedgerEntryType {
  SALE_CREDIT
  COMMISSION_DEBIT
  COMMISSION_TAX_DEBIT
  SHIPPING_CREDIT
  REFUND_DEBIT
  COMMISSION_REVERSAL_CREDIT
  SETTLEMENT_PAYOUT
  MANUAL_ADJUSTMENT
}

enum SettlementStatus {
  PENDING
  APPROVED
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum CouponType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

enum CouponScope {
  ALL
  CATEGORY
  PRODUCT
  SELLER
}

enum FundedBy {
  PLATFORM
  SELLER
}

enum BannerPlacement {
  HERO
  STRIP
  CATEGORY
}

enum HomeSectionType {
  CATEGORY_GRID
  TRENDING
  BEST_SELLERS
  NEW_ARRIVALS
  ON_SALE
  FEATURED_PRODUCTS
  CATEGORY_PRODUCTS
  FEATURED_SELLERS
  RECOMMENDED
  RECENTLY_VIEWED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  REMOVED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
}

enum MessageStatus {
  QUEUED
  SENT
  FAILED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNDISCLOSED
}

// ─────────────────────── Authentication & access ───────────────────────

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  phone               String?    @unique @db.VarChar(20)
  name                String     @db.VarChar(120)
  passwordHash        String?    @db.VarChar(255)
  status              UserStatus @default(ACTIVE)
  emailVerifiedAt     DateTime?
  phoneVerifiedAt     DateTime?
  failedLoginCount    Int        @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  deletionRequestedAt DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?

  roles             UserRole[]
  refreshTokens     RefreshToken[]
  tokens            VerificationToken[]
  seller            Seller?
  customerProfile   CustomerProfile?
  addresses         CustomerAddress[]
  wishlist          Wishlist?
  recentlyViewed    RecentlyViewedProduct[]
  carts             Cart[]
  orders            Order[]
  reviews           Review[]
  reviewReports     ReviewReport[]
  notifications     Notification[]
  couponUsages      CouponUsage[]
  searchHistory     SearchHistory[]
  stockSubscriptions StockSubscription[]
  auditLogs         AuditLog[]      @relation("AuditActor")

  @@index([status])
  @@index([createdAt])
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique @db.VarChar(40)
  name        String           @db.VarChar(80)
  description String?          @db.VarChar(300)
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique @db.VarChar(80)
  description String?          @db.VarChar(300)
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

/// Rotating refresh tokens. Only a SHA-256 hash is stored. Tokens in the same `familyId`
/// descend from one login; re-use of a rotated token revokes the whole family.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique @db.Char(64)
  familyId     String    @db.VarChar(40)
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?   @db.VarChar(300)
  ip           String?   @db.VarChar(64)
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  type      TokenType
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// ─────────────────────────────── Sellers ───────────────────────────────

model Seller {
  id              String          @id @default(cuid())
  userId          String          @unique
  code            String          @unique @db.VarChar(20)
  slug            String          @unique @db.VarChar(160)
  businessName    String          @db.VarChar(160)
  displayName     String          @db.VarChar(160)
  businessType    BusinessType
  gstin           String?         @db.VarChar(15)
  pan             String?         @db.VarChar(10)
  description     String?         @db.Text
  logoUrl         String?         @db.VarChar(500)
  supportEmail    String?
  supportPhone    String?         @db.VarChar(20)
  status          SellerStatus    @default(PENDING_APPROVAL)
  statusReason    String?         @db.VarChar(1000)
  fulfillmentMode FulfillmentMode @default(SELLER)
  isFeatured      Boolean         @default(false)
  ratingAvg       Decimal         @default(0) @db.Decimal(3, 2)
  ratingCount     Int             @default(0)
  termsAcceptedAt DateTime?
  approvedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  user            User                  @relation(fields: [userId], references: [id])
  addresses       SellerAddress[]
  documents       SellerDocument[]
  approvals       SellerApproval[]
  commissionRules CommissionRule[]
  ownedProducts   Product[]             @relation("ProductOwner")
  listings        SellerProductListing[]
  sellerOrders    SellerOrder[]
  orderItems      OrderItem[]
  commissions     Commission[]
  ledgerEntries   SellerLedger[]
  settlements     Settlement[]
  inventory       Inventory[]

  @@index([status])
  @@index([isFeatured])
}

model SellerAddress {
  id        String   @id @default(cuid())
  sellerId  String
  label     String   @default("Registered") @db.VarChar(60)
  line1     String   @db.VarChar(200)
  line2     String?  @db.VarChar(200)
  city      String   @db.VarChar(80)
  state     String   @db.VarChar(80)
  pincode   String   @db.VarChar(10)
  country   String   @default("IN") @db.VarChar(2)
  isPickup  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
}

/// Private KYC documents. `storageKey` points to private storage and is only served through
/// short-lived signed URLs to the owning seller and admins.
model SellerDocument {
  id           String             @id @default(cuid())
  sellerId     String
  type         SellerDocumentType
  storageKey   String             @db.VarChar(500)
  originalName String             @db.VarChar(255)
  mimeType     String             @db.VarChar(100)
  sizeBytes    Int
  status       DocumentStatus     @default(UPLOADED)
  note         String?            @db.VarChar(500)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  seller       Seller             @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
}

/// Immutable history of seller status decisions.
model SellerApproval {
  id         String        @id @default(cuid())
  sellerId   String
  fromStatus SellerStatus?
  toStatus   SellerStatus
  reason     String?       @db.VarChar(1000)
  actorId    String?
  createdAt  DateTime      @default(now())
  seller     Seller        @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, createdAt])
}

/// Commission configuration. Precedence (most specific wins):
/// PRODUCT > SELLER_CATEGORY > SELLER > CATEGORY > GLOBAL > env default.
model CommissionRule {
  id          String          @id @default(cuid())
  scope       CommissionScope
  sellerId    String?
  categoryId  String?
  productId   String?
  percentage  Decimal         @db.Decimal(5, 2)
  fixedAmount Decimal         @default(0) @db.Decimal(12, 2)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  seller      Seller?         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category    Category?       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product     Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([scope, isActive])
  @@index([sellerId])
  @@index([categoryId])
  @@index([productId])
}

// ─────────────────────────────── Catalog ───────────────────────────────

model Category {
  id          String     @id @default(cuid())
  parentId    String?
  name        String     @db.VarChar(120)
  slug        String     @unique @db.VarChar(160)
  path        String     @db.VarChar(1000) /// materialised path of ids: "/rootId/childId/"
  depth       Int        @default(0)
  description String?    @db.Text
  imageUrl    String?    @db.VarChar(500)
  icon        String?    @db.VarChar(60)
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  parent          Category?          @relation("CategoryTree", fields: [parentId], references: [id])
  children        Category[]         @relation("CategoryTree")
  products        Product[]
  attributes      ProductAttribute[]
  commissionRules CommissionRule[]
  taxConfigs      TaxConfiguration[]
  promotions      Promotion[]
  homeSections    HomeSection[]

  @@index([parentId, sortOrder])
  @@index([isActive])
}

model Brand {
  id          String    @id @default(cuid())
  name        String    @db.VarChar(120)
  slug        String    @unique @db.VarChar(160)
  logoUrl     String?   @db.VarChar(500)
  description String?   @db.Text
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  products    Product[]

  @@index([name])
}

/// Catalog product (the "what"). Sellers sell it through SellerProductListing offers.
model Product {
  id               String        @id @default(cuid())
  slug             String        @unique @db.VarChar(220)
  title            String        @db.VarChar(200)
  description      String        @db.Text
  highlights       Json?
  specifications   Json?
  tags             Json?
  searchText       String        @db.Text /// denormalised: title, brand, category, tags, SKUs, attribute values
  categoryId       String
  brandId          String?
  ownerSellerId    String?       /// seller who created the product; null = admin/platform catalog
  hsnCode          String?       @db.VarChar(16)
  status           ProductStatus @default(DRAFT)
  rejectionReason  String?       @db.VarChar(1000)
  isFeatured       Boolean       @default(false)
  isReturnable     Boolean       @default(true)
  returnWindowDays Int           @default(7)
  codAvailable     Boolean       @default(true)
  videoUrl         String?       @db.VarChar(500)
  // Denormalised read-model fields refreshed from listings/reviews/orders
  minPrice         Decimal?      @db.Decimal(12, 2)
  maxMrp           Decimal?      @db.Decimal(12, 2)
  maxDiscountPct   Int           @default(0)
  inStock          Boolean       @default(false)
  ratingAvg        Decimal       @default(0) @db.Decimal(3, 2)
  ratingCount      Int           @default(0)
  soldCount        Int           @default(0)
  viewCount        Int           @default(0)
  publishedAt      DateTime?
  submittedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  category        Category                @relation(fields: [categoryId], references: [id])
  brand           Brand?                  @relation(fields: [brandId], references: [id])
  ownerSeller     Seller?                 @relation("ProductOwner", fields: [ownerSellerId], references: [id])
  variants        ProductVariant[]
  images          ProductImage[]
  attributeValues ProductAttributeValue[]
  listings        SellerProductListing[]
  approvals       ProductApproval[]
  reviews         Review[]
  wishlistItems   WishlistItem[]
  recentlyViewed  RecentlyViewedProduct[]
  commissionRules CommissionRule[]
  orderItems      OrderItem[]
  stockSubscriptions StockSubscription[]

  @@index([status, categoryId])
  @@index([ownerSellerId, status])
  @@index([brandId])
  @@index([status, isFeatured])
  @@index([status, publishedAt])
  @@index([status, soldCount])
  @@index([status, minPrice])
  @@fulltext([title, searchText])
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  name       String   @db.VarChar(160) /// e.g. "Red / M"; "Default" for single-variant products
  options    Json /// { "color": "Red", "size": "M" }
  isDefault  Boolean  @default(false)
  weightGrams Int?
  lengthCm   Decimal? @db.Decimal(8, 2)
  widthCm    Decimal? @db.Decimal(8, 2)
  heightCm   Decimal? @db.Decimal(8, 2)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  product         Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  listings        SellerProductListing[]
  images          ProductImage[]
  attributeValues ProductAttributeValue[]

  @@index([productId])
}

model ProductImage {
  id         String          @id @default(cuid())
  productId  String
  variantId  String?
  url        String          @db.VarChar(500)
  storageKey String?         @db.VarChar(500)
  alt        String?         @db.VarChar(200)
  sortOrder  Int             @default(0)
  createdAt  DateTime        @default(now())
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
}

/// Attribute definition (global when categoryId is null, otherwise category-specific).
model ProductAttribute {
  id            String                  @id @default(cuid())
  categoryId    String?
  name          String                  @db.VarChar(80)
  code          String                  @db.VarChar(60)
  type          AttributeType
  options       Json?
  isFilterable  Boolean                 @default(true)
  isVariantAxis Boolean                 @default(false)
  isRequired    Boolean                 @default(false)
  sortOrder     Int                     @default(0)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  category      Category?               @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  values        ProductAttributeValue[]

  @@unique([categoryId, code])
  @@index([code])
}

model ProductAttributeValue {
  id          String           @id @default(cuid())
  productId   String
  variantId   String?
  attributeId String
  value       String           @db.VarChar(200)
  product     Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute   ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@index([attributeId, value])
  @@index([productId])
}

/// A seller's offer for one product variant: price, SKU, stock and status belong to the seller.
model SellerProductListing {
  id              String        @id @default(cuid())
  sellerId        String
  productId       String
  variantId       String
  sku             String        @db.VarChar(64)
  barcode         String?       @db.VarChar(64)
  price           Decimal       @db.Decimal(12, 2)
  mrp             Decimal       @db.Decimal(12, 2)
  status          ProductStatus @default(DRAFT)
  isActive        Boolean       @default(true) /// seller-controlled on/off switch for approved listings
  rejectionReason String?       @db.VarChar(1000)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  seller     Seller         @relation(fields: [sellerId], references: [id])
  product    Product        @relation(fields: [productId], references: [id])
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  inventory  Inventory?
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([sellerId, sku])
  @@unique([sellerId, variantId])
  @@index([productId, status, isActive])
  @@index([sellerId, status])
  @@index([sku])
}

/// Immutable history of product review decisions.
model ProductApproval {
  id         String         @id @default(cuid())
  productId  String
  fromStatus ProductStatus?
  toStatus   ProductStatus
  reason     String?        @db.VarChar(1000)
  actorId    String?
  createdAt  DateTime       @default(now())
  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
}

/// One row per listing. available = quantity - reserved. Mutated only through atomic
/// conditional UPDATEs inside transactions (see inventory.service.ts).
model Inventory {
  id                String              @id @default(cuid())
  listingId         String              @unique
  sellerId          String
  quantity          Int                 @default(0)
  reserved          Int                 @default(0)
  lowStockThreshold Int                 @default(5)
  lowStockAlertedAt DateTime?
  updatedAt         DateTime            @updatedAt
  createdAt         DateTime            @default(now())
  listing           SellerProductListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  seller            Seller              @relation(fields: [sellerId], references: [id])
  movements         InventoryMovement[]

  @@index([sellerId])
}

model InventoryMovement {
  id             String                @id @default(cuid())
  inventoryId    String
  type           InventoryMovementType
  quantityDelta  Int                   @default(0)
  reservedDelta  Int                   @default(0)
  quantityAfter  Int
  reservedAfter  Int
  reason         String?               @db.VarChar(300)
  referenceType  String?               @db.VarChar(40)
  referenceId    String?
  actorId        String?
  createdAt      DateTime              @default(now())
  inventory      Inventory             @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId, createdAt])
  @@index([referenceType, referenceId])
}

model StockSubscription {
  id         String    @id @default(cuid())
  userId     String
  productId  String
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// ─────────────────────────────── Customers ───────────────────────────────

model CustomerProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  gender      Gender?
  dateOfBirth DateTime?
  avatarUrl   String?   @db.VarChar(500)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CustomerAddress {
  id        String      @id @default(cuid())
  userId    String
  fullName  String      @db.VarChar(120)
  phone     String      @db.VarChar(20)
  line1     String      @db.VarChar(200)
  line2     String?     @db.VarChar(200)
  landmark  String?     @db.VarChar(120)
  city      String      @db.VarChar(80)
  state     String      @db.VarChar(80)
  pincode   String      @db.VarChar(10)
  country   String      @default("IN") @db.VarChar(2)
  type      AddressType @default(HOME)
  isDefault Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
}

model RecentlyViewedProduct {
  id        String   @id @default(cuid())
  userId    String
  productId String
  viewedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, viewedAt])
}

model SearchHistory {
  id           String   @id @default(cuid())
  userId       String?
  query        String   @db.VarChar(120)
  normalized   String   @db.VarChar(120)
  resultsCount Int      @default(0)
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([normalized])
  @@index([createdAt])
}

// ─────────────────────────────── Cart ───────────────────────────────

/// A cart belongs either to a user or to an anonymous guest token (merged on login).
model Cart {
  id         String     @id @default(cuid())
  userId     String?    @unique
  guestToken String?    @unique @db.Char(64)
  couponCode String?    @db.VarChar(40)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      CartItem[]

  @@index([updatedAt])
}

model CartItem {
  id           String               @id @default(cuid())
  cartId       String
  listingId    String
  quantity     Int
  priceAtAdd   Decimal              @db.Decimal(12, 2) /// used to surface price changes, never to charge
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  cart         Cart                 @relation(fields: [cartId], references: [id], onDelete: Cascade)
  listing      SellerProductListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([cartId, listingId])
}

// ─────────────────────────────── Orders ───────────────────────────────

/// Customer-facing parent order. One parent → one SellerOrder per fulfilling seller → OrderItems.
model Order {
  id               String         @id @default(cuid())
  orderNumber      String         @unique @db.VarChar(24)
  customerId       String
  idempotencyKey   String         @db.VarChar(64)
  status           OrderStatus    @default(PENDING_CONFIRMATION)
  paymentMethod    PaymentMethod
  paymentStatus    PaymentStatus
  shippingMethod   ShippingMethod @default(STANDARD)
  currency         String         @default("INR") @db.VarChar(3)
  itemsSubtotal    Decimal        @db.Decimal(12, 2) /// Σ unit price × qty
  mrpTotal         Decimal        @db.Decimal(12, 2)
  discountTotal    Decimal        @default(0) @db.Decimal(12, 2) /// coupon discount
  shippingTotal    Decimal        @default(0) @db.Decimal(12, 2)
  codFee           Decimal        @default(0) @db.Decimal(12, 2)
  taxTotal         Decimal        @default(0) @db.Decimal(12, 2) /// informational when prices are tax-inclusive
  grandTotal       Decimal        @db.Decimal(12, 2)
  refundedTotal    Decimal        @default(0) @db.Decimal(12, 2)
  couponId         String?
  couponCode       String?        @db.VarChar(40)
  // Delivery address snapshot
  shipName         String         @db.VarChar(120)
  shipPhone        String         @db.VarChar(20)
  shipLine1        String         @db.VarChar(200)
  shipLine2        String?        @db.VarChar(200)
  shipLandmark     String?        @db.VarChar(120)
  shipCity         String         @db.VarChar(80)
  shipState        String         @db.VarChar(80)
  shipPincode      String         @db.VarChar(10)
  shipCountry      String         @default("IN") @db.VarChar(2)
  notes            String?        @db.VarChar(500)
  placedAt         DateTime       @default(now())
  cancelledAt      DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  customer      User                 @relation(fields: [customerId], references: [id])
  coupon        Coupon?              @relation(fields: [couponId], references: [id])
  sellerOrders  SellerOrder[]
  items         OrderItem[]
  payments      Payment[]
  statusHistory OrderStatusHistory[]
  returns       ReturnRequest[]
  refunds       Refund[]
  couponUsages  CouponUsage[]

  @@unique([customerId, idempotencyKey])
  @@index([customerId, placedAt])
  @@index([status, placedAt])
  @@index([paymentStatus])
  @@index([placedAt])
}

/// Seller-specific sub-order / fulfillment group. Sellers only ever see their own SellerOrders.
model SellerOrder {
  id              String          @id @default(cuid())
  subOrderNumber  String          @unique @db.VarChar(28)
  orderId         String
  sellerId        String
  status          OrderStatus     @default(PENDING_CONFIRMATION)
  fulfillmentMode FulfillmentMode @default(SELLER)
  itemsSubtotal   Decimal         @db.Decimal(12, 2)
  discountTotal   Decimal         @default(0) @db.Decimal(12, 2)
  shippingTotal   Decimal         @default(0) @db.Decimal(12, 2)
  taxTotal        Decimal         @default(0) @db.Decimal(12, 2)
  grandTotal      Decimal         @db.Decimal(12, 2)
  commissionTotal Decimal         @default(0) @db.Decimal(12, 2)
  codCollected    Boolean         @default(false)
  codCollectedAt  DateTime?
  cancelReason    String?         @db.VarChar(500)
  confirmedAt     DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  order         Order                @relation(fields: [orderId], references: [id])
  seller        Seller               @relation(fields: [sellerId], references: [id])
  items         OrderItem[]
  shipments     Shipment[]
  statusHistory OrderStatusHistory[]
  returns       ReturnRequest[]

  @@unique([orderId, sellerId])
  @@index([sellerId, status, createdAt])
  @@index([sellerId, createdAt])
  @@index([status])
}

/// Line item with immutable snapshots of product, pricing, tax and commission.
model OrderItem {
  id                 String      @id @default(cuid())
  orderId            String
  sellerOrderId      String
  sellerId           String
  listingId          String?
  productId          String?
  variantId          String?
  categoryId         String?
  // Snapshots
  productName        String      @db.VarChar(200)
  variantName        String?     @db.VarChar(160)
  sku                String      @db.VarChar(64)
  sellerName         String      @db.VarChar(160)
  imageUrl           String?     @db.VarChar(500)
  hsnCode            String?     @db.VarChar(16)
  // Pricing (per unit and per line)
  unitPrice          Decimal     @db.Decimal(12, 2)
  unitMrp            Decimal     @db.Decimal(12, 2)
  quantity           Int
  cancelledQuantity  Int         @default(0)
  returnedQuantity   Int         @default(0)
  lineSubtotal       Decimal     @db.Decimal(12, 2) /// unitPrice × quantity
  discountAmount     Decimal     @default(0) @db.Decimal(12, 2) /// allocated coupon discount
  sellerFundedDiscount Decimal   @default(0) @db.Decimal(12, 2)
  shippingAmount     Decimal     @default(0) @db.Decimal(12, 2) /// allocated share of sub-order shipping
  taxRate            Decimal     @default(0) @db.Decimal(5, 2)
  taxAmount          Decimal     @default(0) @db.Decimal(12, 2)
  taxInclusive       Boolean     @default(true)
  lineTotal          Decimal     @db.Decimal(12, 2) /// amount payable by the customer for this line
  commissionRate     Decimal     @default(0) @db.Decimal(5, 2)
  commissionFixed    Decimal     @default(0) @db.Decimal(12, 2)
  commissionAmount   Decimal     @default(0) @db.Decimal(12, 2)
  status             OrderStatus @default(PENDING_CONFIRMATION)
  isReturnable       Boolean     @default(true)
  returnWindowDays   Int         @default(7)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  order         Order                 @relation(fields: [orderId], references: [id])
  sellerOrder   SellerOrder           @relation(fields: [sellerOrderId], references: [id])
  seller        Seller                @relation(fields: [sellerId], references: [id])
  listing       SellerProductListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  product       Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  commission    Commission?
  shipmentItems ShipmentItem[]
  returnItems   ReturnItem[]
  review        Review?

  @@index([orderId])
  @@index([sellerOrderId])
  @@index([sellerId, createdAt])
  @@index([productId])
}

model OrderStatusHistory {
  id            String       @id @default(cuid())
  orderId       String
  sellerOrderId String?
  fromStatus    OrderStatus?
  toStatus      OrderStatus
  note          String?      @db.VarChar(500)
  actorId       String?
  actorRole     String?      @db.VarChar(20)
  createdAt     DateTime     @default(now())
  order         Order        @relation(fields: [orderId], references: [id])
  sellerOrder   SellerOrder? @relation(fields: [sellerOrderId], references: [id])

  @@index([orderId, createdAt])
  @@index([sellerOrderId, createdAt])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  provider    String        @db.VarChar(40) /// "cod" today; "razorpay", "stripe" … later
  method      PaymentMethod
  amount      Decimal       @db.Decimal(12, 2)
  collected   Decimal       @default(0) @db.Decimal(12, 2)
  refunded    Decimal       @default(0) @db.Decimal(12, 2)
  status      PaymentStatus
  providerRef String?       @db.VarChar(120)
  metadata    Json?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  order       Order         @relation(fields: [orderId], references: [id])
  refunds     Refund[]

  @@index([orderId])
  @@index([status])
}

model Shipment {
  id                String          @id @default(cuid())
  sellerOrderId     String
  carrier           String?         @db.VarChar(80)
  trackingNumber    String?         @db.VarChar(80)
  trackingUrl       String?         @db.VarChar(500)
  status            ShipmentStatus  @default(PENDING)
  shippedAt         DateTime?
  deliveredAt       DateTime?
  estimatedFrom     DateTime?
  estimatedTo       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  sellerOrder       SellerOrder     @relation(fields: [sellerOrderId], references: [id])
  items             ShipmentItem[]
  events            ShipmentEvent[]

  @@index([sellerOrderId])
  @@index([trackingNumber])
}

model ShipmentItem {
  id          String    @id @default(cuid())
  shipmentId  String
  orderItemId String
  quantity    Int
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  @@unique([shipmentId, orderItemId])
}

model ShipmentEvent {
  id         String         @id @default(cuid())
  shipmentId String
  status     ShipmentStatus
  location   String?        @db.VarChar(120)
  note       String?        @db.VarChar(500)
  occurredAt DateTime       @default(now())
  shipment   Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
}

model ReturnRequest {
  id            String       @id @default(cuid())
  returnNumber  String       @unique @db.VarChar(24)
  orderId       String
  sellerOrderId String
  customerId    String
  status        ReturnStatus @default(REQUESTED)
  reason        String       @db.VarChar(120)
  comments      String?      @db.VarChar(1000)
  decisionNote  String?      @db.VarChar(500)
  restock       Boolean      @default(true)
  refundAmount  Decimal      @default(0) @db.Decimal(12, 2)
  decidedAt     DateTime?
  receivedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  order         Order        @relation(fields: [orderId], references: [id])
  sellerOrder   SellerOrder  @relation(fields: [sellerOrderId], references: [id])
  items         ReturnItem[]
  refunds       Refund[]

  @@index([orderId])
  @@index([sellerOrderId, status])
  @@index([customerId])
}

model ReturnItem {
  id              String        @id @default(cuid())
  returnRequestId String
  orderItemId     String
  quantity        Int
  refundAmount    Decimal       @db.Decimal(12, 2)
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id])

  @@unique([returnRequestId, orderItemId])
}

/// Refunds for cancellations (only when money was collected) and returns.
model Refund {
  id              String         @id @default(cuid())
  orderId         String
  paymentId       String?
  returnRequestId String?
  amount          Decimal        @db.Decimal(12, 2)
  status          RefundStatus   @default(PENDING)
  method          String         @db.VarChar(40) /// "bank_transfer", "upi", "original" …
  reference       String?        @db.VarChar(120)
  reason          String?        @db.VarChar(500)
  processedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  order           Order          @relation(fields: [orderId], references: [id])
  payment         Payment?       @relation(fields: [paymentId], references: [id])
  returnRequest   ReturnRequest? @relation(fields: [returnRequestId], references: [id])

  @@index([orderId])
  @@index([status])
}

// ─────────────────────────── Marketplace finance ───────────────────────────

/// Item-level commission record (1:1 with OrderItem). Amounts are adjusted only via
/// ledger entries; the record keeps the originally computed figures.
model Commission {
  id           String           @id @default(cuid())
  orderItemId  String           @unique
  sellerId     String
  baseAmount   Decimal          @db.Decimal(12, 2)
  rate         Decimal          @db.Decimal(5, 2)
  fixedAmount  Decimal          @default(0) @db.Decimal(12, 2)
  amount       Decimal          @db.Decimal(12, 2)
  taxRate      Decimal          @default(0) @db.Decimal(5, 2)
  taxAmount    Decimal          @default(0) @db.Decimal(12, 2)
  ruleId       String?
  ruleScope    CommissionScope
  status       CommissionStatus @default(ACCRUED)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  orderItem    OrderItem        @relation(fields: [orderItemId], references: [id])
  seller       Seller           @relation(fields: [sellerId], references: [id])

  @@index([sellerId, status])
  @@index([createdAt])
}

/// Append-only seller ledger. Balance = Σ amount. Never updated or deleted.
model SellerLedger {
  id            String          @id @default(cuid())
  sellerId      String
  type          LedgerEntryType
  amount        Decimal         @db.Decimal(12, 2) /// signed: credits > 0, debits < 0
  balanceAfter  Decimal         @db.Decimal(14, 2)
  description   String          @db.VarChar(300)
  orderId       String?
  sellerOrderId String?
  orderItemId   String?
  settlementId  String?
  actorId       String?
  createdAt     DateTime        @default(now())
  seller        Seller          @relation(fields: [sellerId], references: [id])
  settlement    Settlement?     @relation(fields: [settlementId], references: [id])

  @@index([sellerId, createdAt])
  @@index([sellerOrderId])
  @@index([orderItemId, type])
}

model Settlement {
  id               String           @id @default(cuid())
  settlementNumber String           @unique @db.VarChar(24)
  sellerId         String
  amount           Decimal          @db.Decimal(12, 2)
  status           SettlementStatus @default(PENDING)
  periodStart      DateTime?
  periodEnd        DateTime?
  reference        String?          @db.VarChar(120) /// bank UTR / transfer reference entered by admin
  notes            String?          @db.VarChar(1000)
  createdById      String?
  approvedById     String?
  approvedAt       DateTime?
  paidAt           DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  seller           Seller           @relation(fields: [sellerId], references: [id])
  transactions     SettlementTransaction[]
  ledgerEntries    SellerLedger[]

  @@index([sellerId, status])
  @@index([status, createdAt])
}

/// Immutable audit trail of every settlement status change.
model SettlementTransaction {
  id           String            @id @default(cuid())
  settlementId String
  fromStatus   SettlementStatus?
  toStatus     SettlementStatus
  amount       Decimal           @db.Decimal(12, 2)
  reference    String?           @db.VarChar(120)
  note         String?           @db.VarChar(1000)
  actorId      String?
  createdAt    DateTime          @default(now())
  settlement   Settlement        @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([settlementId, createdAt])
}

// ─────────────────────────────── Marketing ───────────────────────────────

model Coupon {
  id               String        @id @default(cuid())
  code             String        @unique @db.VarChar(40)
  description      String?       @db.VarChar(300)
  type             CouponType
  value            Decimal       @default(0) @db.Decimal(12, 2)
  maxDiscount      Decimal?      @db.Decimal(12, 2)
  minOrderAmount   Decimal       @default(0) @db.Decimal(12, 2)
  scope            CouponScope   @default(ALL)
  scopeIds         Json?
  fundedBy         FundedBy      @default(PLATFORM)
  startsAt         DateTime
  endsAt           DateTime
  usageLimit       Int?
  usedCount        Int           @default(0)
  perCustomerLimit Int           @default(1)
  firstOrderOnly   Boolean       @default(false)
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?
  usages           CouponUsage[]
  orders           Order[]

  @@index([isActive, startsAt, endsAt])
}

model CouponUsage {
  id             String   @id @default(cuid())
  couponId       String
  userId         String
  orderId        String   @unique
  discountAmount Decimal  @db.Decimal(12, 2)
  releasedAt     DateTime? /// set when the whole order is cancelled and the usage is returned
  createdAt      DateTime @default(now())
  coupon         Coupon   @relation(fields: [couponId], references: [id])
  user           User     @relation(fields: [userId], references: [id])
  order          Order    @relation(fields: [orderId], references: [id])

  @@index([couponId, userId])
}

/// Time-boxed sale campaigns used for "on sale" merchandising and badges.
model Promotion {
  id              String    @id @default(cuid())
  name            String    @db.VarChar(120)
  description     String?   @db.VarChar(500)
  discountPercent Decimal   @db.Decimal(5, 2)
  categoryId      String?
  startsAt        DateTime
  endsAt          DateTime
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([isActive, startsAt, endsAt])
}

model Banner {
  id        String          @id @default(cuid())
  title     String          @db.VarChar(160)
  subtitle  String?         @db.VarChar(300)
  ctaLabel  String?         @db.VarChar(40)
  linkUrl   String?         @db.VarChar(500)
  imageUrl  String?         @db.VarChar(500)
  theme     String?         @db.VarChar(200) /// CSS gradient / colour token used when no image is set
  placement BannerPlacement @default(HERO)
  sortOrder Int             @default(0)
  isActive  Boolean         @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([placement, isActive, sortOrder])
}

/// Admin-configurable homepage section.
model HomeSection {
  id         String          @id @default(cuid())
  type       HomeSectionType
  title      String          @db.VarChar(120)
  subtitle   String?         @db.VarChar(200)
  categoryId String?
  limit      Int             @default(12)
  sortOrder  Int             @default(0)
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  category   Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([isActive, sortOrder])
}

// ─────────────────────────────── Engagement ───────────────────────────────

model Review {
  id                 String         @id @default(cuid())
  productId          String
  userId             String
  orderItemId        String?        @unique
  rating             Int
  title              String?        @db.VarChar(120)
  body               String?        @db.Text
  isVerifiedPurchase Boolean        @default(false)
  status             ReviewStatus   @default(PENDING)
  moderationNote     String?        @db.VarChar(500)
  helpfulCount       Int            @default(0)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?
  product            Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItem          OrderItem?     @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  images             ReviewImage[]
  reports            ReviewReport[]

  @@unique([productId, userId])
  @@index([productId, status, createdAt])
  @@index([status])
}

model ReviewImage {
  id         String   @id @default(cuid())
  reviewId   String
  url        String   @db.VarChar(500)
  storageKey String?  @db.VarChar(500)
  createdAt  DateTime @default(now())
  review     Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model ReviewReport {
  id         String    @id @default(cuid())
  reviewId   String
  userId     String
  reason     String    @db.VarChar(300)
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  review     Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String    @db.VarChar(60)
  title     String    @db.VarChar(200)
  body      String    @db.VarChar(1000)
  link      String?   @db.VarChar(500)
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

/// Admin-editable templates. `key` is the event (e.g. "order.placed"), one row per channel.
model NotificationTemplate {
  id        String              @id @default(cuid())
  key       String              @db.VarChar(80)
  channel   NotificationChannel
  subject   String              @db.VarChar(200)
  body      String              @db.Text
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([key, channel])
}

/// Outbound email/SMS/WhatsApp log. In development this doubles as the mail preview inbox.
model OutboundMessage {
  id        String              @id @default(cuid())
  channel   NotificationChannel
  recipient String              @db.VarChar(191)
  subject   String?             @db.VarChar(200)
  body      String              @db.Text
  status    MessageStatus       @default(QUEUED)
  error     String?             @db.VarChar(1000)
  templateKey String?           @db.VarChar(80)
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([recipient, createdAt])
  @@index([createdAt])
}

// ─────────────────────────────── System ───────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorRole  String?  @db.VarChar(20)
  action     String   @db.VarChar(80) /// e.g. "seller.approve", "product.update"
  entityType String   @db.VarChar(40)
  entityId   String?
  before     Json?
  after      Json?
  metadata   Json?
  ip         String?  @db.VarChar(64)
  userAgent  String?  @db.VarChar(300)
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

model SecurityEvent {
  id        String   @id @default(cuid())
  type      String   @db.VarChar(60) /// LOGIN_FAILED, ACCOUNT_LOCKED, REFRESH_REUSE, ACCESS_DENIED, RATE_LIMITED …
  userId    String?
  email     String?  @db.VarChar(191)
  ip        String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(300)
  details   Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model SystemSetting {
  key         String   @id @db.VarChar(100)
  value       Json
  description String?  @db.VarChar(300)
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model TaxConfiguration {
  id          String    @id @default(cuid())
  name        String    @db.VarChar(80)
  categoryId  String?   /// null = default rate
  rate        Decimal   @db.Decimal(5, 2)
  isInclusive Boolean   @default(true)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, isActive])
}

model ShippingConfiguration {
  id        String         @id @default(cuid())
  method    ShippingMethod @unique
  label     String         @db.VarChar(80)
  baseFee   Decimal        @db.Decimal(12, 2) /// charged per seller sub-order
  freeAbove Decimal?       @db.Decimal(12, 2) /// sub-order subtotal at/above which shipping is free
  minDays   Int
  maxDays   Int
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

/// Optional delivery-area restrictions. When the table is empty every valid PIN is serviceable.
model ServiceablePincode {
  id            String   @id @default(cuid())
  pincode       String   @unique @db.VarChar(10)
  city          String?  @db.VarChar(80)
  state         String?  @db.VarChar(80)
  isServiceable Boolean  @default(true)
  codAvailable  Boolean  @default(true)
  extraDays     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
