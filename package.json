{
  "name": "@vyora/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e .env -- tsx watch --clear-screen=false src/server.ts",
    "start": "node dist/server.js",
    "build": "prisma generate && tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "dotenv -e .env.test -e .env -- vitest run",
    "test:watch": "dotenv -e .env.test -e .env -- vitest",
    "test:db:prepare": "dotenv -e .env.test -e .env -- prisma migrate reset --force --skip-seed",
    "prisma": "dotenv -e .env -- prisma",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e .env -- prisma migrate dev",
    "db:deploy": "dotenv -e .env -- prisma migrate deploy",
    "db:seed": "dotenv -e .env -- tsx prisma/seed.ts",
    "db:reset": "dotenv -e .env -- prisma migrate reset --force",
    "db:check": "dotenv -e .env -- tsx src/scripts/db-check.ts",
    "db:refresh-demo": "dotenv -e .env -- tsx prisma/refresh-demo.ts",
    "db:use": "node scripts/use-db.mjs",
    "db:e2e:prepare": "dotenv -e .env.e2e -e .env -- prisma migrate deploy && dotenv -e .env.e2e -e .env -- tsx prisma/seed.ts",
    "dev:e2e": "dotenv -e .env.e2e -e .env -- tsx src/server.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@hapi/hapi": "^21.4.10",
    "@prisma/client": "6.19.3",
    "@vyora/shared": "link:./vendor/shared",
    "argon2": "^0.45.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.5",
    "busboy": "^1.6.0",
    "cors": "^2.8.6",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^6.10.1",
    "pino": "^10.3.1",
    "sharp": "^0.34.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/busboy": "^1.5.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^6.0.3",
    "dotenv-cli": "^8.0.0",
    "pino-pretty": "^13.1.3",
    "prisma": "6.19.3",
    "supertest": "^7.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
